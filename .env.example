# Local development defaults to SQLite in .data/. Production requires PostgreSQL.
# DATABASE_URL=postgresql://user:password@host:5432/koskin
PUBLIC_SITE_URL=http://localhost:3000
# Primary search/indexing domain; independent of the platform subdomain.
SEO_SITE_URL=https://romankoskin.art
# Enabled by default in production. Set 0 only while staging domain routing.
CANONICAL_REDIRECTS=1
# Verification tokens only, without the full HTML tag.
# GOOGLE_SITE_VERIFICATION=
# YANDEX_SITE_VERIFICATION=
# Optional API token for reading received enquiries: generate a long random value.
# ADMIN_API_TOKEN=
# Admin panel: generate hash with python scripts/setup-admin.py --hash.
ADMIN_USERNAME=roman
# ADMIN_PASSWORD_HASH=pbkdf2_sha256$600000$...
